// Aegis — AI Agent Control Plane
// Prisma schema. PostgreSQL is the intended production database.
//
// Domain shape:
//   Organization is the tenant boundary. Every tenant-owned resource
//   (Agent, ActivityEvent, and future Policy/Approval/Cost/Audit/ApiKey
//   models) carries an organizationId and must be reached only through
//   server-side queries that verify the caller's membership first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth — Auth.js (NextAuth v5) compatible models, plus a local passwordHash
// for the credentials provider. Account/Session/VerificationToken keep the
// schema ready for OAuth providers later without any structural change.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                   Account[]
  sessions                   Session[]
  memberships                OrganizationMember[]
  createdPolicies            Policy[]
  approvalDecisions          ApprovalDecision[]
  auditEvents                AuditEvent[]
  apiKeys                    ApiKey[]
  acknowledgedSecurityAlerts SecurityAlert[]          @relation("SecurityAlertAcknowledgedBy")
  resolvedSecurityAlerts     SecurityAlert[]          @relation("SecurityAlertResolvedBy")
  createdWebhookEndpoints    WebhookEndpoint[]
  sentInvitations            OrganizationInvitation[]
  featureRequests            FeatureRequest[]
  featureRequestVotes        FeatureRequestVote[]
  createdBudgets             Budget[]
  createdAgentConnections    AgentConnection[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

enum AccountType {
  PERSONAL
  TEAM
  ENTERPRISE
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  plan        String      @default("free")
  // Personal/Team/Enterprise use-case, chosen during onboarding. Defaults to
  // TEAM so every pre-existing organization keeps behaving exactly as
  // before — this column only changes how new organizations are labeled and
  // how the dashboard presents member/invite/team UI (see
  // app/(dashboard)/settings/organization/page.tsx); it is not an
  // access-control boundary and never affects organizationId-scoped
  // isolation.
  accountType AccountType @default(TEAM)

  // Billing. `plan` above is the actual source of truth Aegis enforces
  // entitlements against (see lib/billing/plans.ts); these fields mirror
  // Paddle's own subscription state so the org's billing status survives
  // without a live API call on every request. Null/"free" until a checkout
  // actually completes — see lib/billing/paddle.ts and
  // app/api/webhooks/paddle/route.ts for how they're populated, and
  // docs/deployment.md for what configuring Paddle requires.
  paddleCustomerId     String?
  paddleSubscriptionId String?
  paddlePriceId        String?
  subscriptionStatus   String?
  billingInterval      String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  // Retention — configuration only. Nothing in the application deletes
  // data automatically based on these; see docs/retention.md. Null means
  // "no configured limit," not "delete immediately."
  activityRetentionDays Int?
  auditRetentionDays    Int?
  securityRetentionDays Int?

  // SSO — schema placeholder only, no SAML/OIDC integration exists yet.
  // See docs/rbac.md and the Settings > Security "coming soon" card.
  ssoEnabled  Boolean @default(false)
  ssoProvider String?

  // Policy-matching compatibility escape hatch (P0 security fix, see
  // docs/AEGIS_P0_IMPLEMENTATION.md §2). false (the default for every org,
  // existing and new) = STRICT matching: security-sensitive context comes
  // from the server-side Agent record, and a field/condition the caller
  // omitted can never let an action slip past a BLOCK/REQUIRE_APPROVAL/
  // ALERT policy. true = the pre-P0 matcher (caller-declared context,
  // omitted field = policy does not match). Deliberately has no dashboard
  // toggle: it weakens security, so it's a support-applied (direct DB update,
  // not in the in-app audit trail — log it externally), temporary migration aid — never something to flip casually.
  legacyPolicyMatching Boolean @default(false)

  // P5 risk-driven control (docs/AEGIS_P5_CONTROL.md). OBSERVE (the default
  // for every org, existing and new) = risk is assessed and compared with the
  // real decision but never changes it. Medium/High say what a MEDIUM / HIGH-or-
  // CRITICAL assessment maps to; they also drive the shadow "recommended"
  // decision while in OBSERVE, so an org can see "would have blocked" before
  // enabling anything. Changes are audited (organization.risk_control_update).
  riskControlMode  RiskControlMode @default(OBSERVE)
  riskMediumAction PolicyDecision  @default(ALERT)
  riskHighAction   PolicyDecision  @default(REQUIRE_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           OrganizationMember[]
  agents            Agent[]
  riskReviewLabels  RiskReviewLabel[]
  incidents         Incident[]
  incidentActivity  IncidentActivity[]
  activityEvents    ActivityEvent[]
  agentPermissions  AgentPermission[]
  policies          Policy[]
  policyEvaluations PolicyEvaluation[]
  approvalRequests  ApprovalRequest[]
  approvalDecisions ApprovalDecision[]
  auditEvents       AuditEvent[]
  apiKeys           ApiKey[]
  securityAlerts    SecurityAlert[]
  teams             Team[]
  invitations       OrganizationInvitation[]
  webhookEndpoints  WebhookEndpoint[]
  featureRequests   FeatureRequest[]
  budgets           Budget[]
  agentConnections  AgentConnection[]
  activityRollups   AgentActivityRollup[]
  baselines         AgentBaseline[]
  deviations        BehavioralDeviation[]
  trustStates       AgentTrustState[]
  trustTransitions  AgentTrustTransition[]

  @@map("organizations")
}

enum MemberRole {
  OWNER
  ADMIN
  ENGINEER
  SECURITY
  FINANCE
  VIEWER
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(ENGINEER)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

enum AgentStatus {
  ACTIVE
  PAUSED
  // Kill-switch state — stronger than PAUSED. Both states mean the same
  // thing technically (Aegis has no enforcement connector for either, see
  // lib/enforcement/); STOPPED exists as a distinct signal of operator
  // intent ("shut this down, not just temporarily pause it").
  STOPPED
  NEEDS_ATTENTION
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// How an organization lets the risk engine influence decisions.
//   OBSERVE            record only (shadow); never changes a decision
//   APPROVAL_REQUIRED  risk may add ALERT / REQUIRE_APPROVAL, never BLOCK
//   ENFORCE            risk may also BLOCK, as configured
enum RiskControlMode {
  OBSERVE
  APPROVAL_REQUIRED
  ENFORCE
}

enum RiskReviewLabelValue {
  JUSTIFIED
  FALSE_POSITIVE
  UNSURE
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

model Agent {
  id             String  @id @default(cuid())
  organizationId String
  teamId         String?

  name        String
  slug        String
  description String?     @db.Text
  status      AgentStatus @default(ACTIVE)
  riskLevel   RiskLevel   @default(LOW)
  environment Environment @default(PRODUCTION)

  owner String // owning team or individual, e.g. "Revenue", "Platform" — free text; teamId below is the optional structured version used for cost breakdowns

  modelProvider String // e.g. "OpenAI", "Anthropic"
  modelName     String // e.g. "gpt-4.1", "claude-sonnet-4.5"
  framework     String? // e.g. "LangChain", "custom"
  sdkVersion    String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team              Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tools             AgentTool[]
  activityEvents    ActivityEvent[]
  permissions       AgentPermission[]
  policies          Policy[]
  policyEvaluations PolicyEvaluation[]
  approvalRequests  ApprovalRequest[]
  auditEvents       AuditEvent[]
  securityAlerts    SecurityAlert[]
  budgets           Budget[]
  connection        AgentConnection?
  boundApiKeys      ApiKey[]
  activityRollups   AgentActivityRollup[]
  behaviorState     AgentBehaviorState?
  baselines         AgentBaseline[]
  deviations        BehavioralDeviation[]
  trustState        AgentTrustState?
  trustTransitions  AgentTrustTransition[]
  incidents         Incident[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([teamId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// Agent connections — real, verified links between an Agent record and the
// provider it actually runs on. Replaces free-typed modelProvider/modelName
// entry with an actual technical connection: a credential Aegis verified
// against the provider's own API (OPENAI/ANTHROPIC), or the existing
// SDK/API-key ingestion path (CUSTOM_SDK). See lib/connectors/ for the
// connector implementations and docs/connect-agent.md for the full design.
//
// One row per Agent (1:1) — an agent that predates this feature (created by
// the old manual form) simply has no AgentConnection row; it keeps working
// exactly as before and is never retroactively "disconnected".
// ---------------------------------------------------------------------------

enum ConnectorType {
  OPENAI
  ANTHROPIC
  CUSTOM_SDK
}

enum ConnectionStatus {
  CONNECTING
  VERIFYING
  CONNECTED
  DEGRADED
  RECONNECT_REQUIRED
  DISCONNECTED
  FAILED
}

model AgentConnection {
  id             String @id @default(cuid())
  organizationId String
  agentId        String @unique

  connectorType ConnectorType
  status        ConnectionStatus @default(CONNECTED)

  // Provider-side identity, when known. externalAccountLabel is a
  // display-only masked identifier (e.g. "sk-...ab12") — NEVER the raw
  // credential. externalAgentId is the provider's own id for the
  // discovered resource (e.g. an OpenAI assistant id) — null for
  // ANTHROPIC (no discovery API exists there) and CUSTOM_SDK (no
  // provider-side resource to reference).
  externalAccountLabel String?
  externalAgentId      String?

  // Encrypted credential, OPENAI/ANTHROPIC only — see
  // lib/connectors/crypto.ts (AES-256-GCM, key derived from AUTH_SECRET).
  // Null for CUSTOM_SDK, which authenticates ingestion via ApiKey instead
  // of a stored provider credential. Cleared (set back to null) on
  // disconnect — see lib/agents/connection-service.ts.
  credentialCiphertext String? @db.Text
  credentialIv         String?
  credentialAuthTag    String?
  // Which key encrypted the credential — see lib/connectors/crypto.ts.
  // Null = written before key versioning existed (always the
  // AUTH_SECRET-derived key at the time). Lets the key rotate without
  // making stored credentials unreadable.
  credentialKeyId      String?

  // The Aegis API key auto-provisioned for this connection's SDK
  // ingestion, if one was created at connect time (CUSTOM_SDK only) — lets
  // disconnect() revoke precisely this key without touching any other key
  // the organization uses. SetNull (not Cascade): revoking/deleting the
  // key from Developers > API Keys should not delete connection history.
  apiKeyId String?

  // Snapshot of AgentConnector.capabilities (lib/connectors/types.ts) at
  // connect time. The UI must never present an affordance this doesn't
  // list as true — see the "truthful capabilities" rule in
  // docs/connect-agent.md.
  capabilities Json

  connectedAt       DateTime  @default(now())
  disconnectedAt    DateTime?
  // Handshake evidence (docs/AEGIS_AGENT_CONNECTION.md). Set ONLY when a request authenticated with this
  // connection's own agent-bound credential actually reached Aegis: firstHandshakeAt once, lastSeenAt on
  // every later contact (written at most once a minute). Null = the agent has never contacted Aegis.
  firstHandshakeAt  DateTime?
  lastSeenAt        DateTime?
  lastVerifiedAt    DateTime?
  lastHealthCheckAt DateTime?
  lastHealthError   String?   @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([apiKeyId])
  @@map("agent_connections")
}

model AgentTool {
  id       String @id @default(cuid())
  agentId  String
  name     String // e.g. "CRM", "Email", "Zendesk"
  category String // e.g. "Data", "Communication", "Deployment"

  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@map("agent_tools")
}

// ---------------------------------------------------------------------------
// Structured activity — the event backbone. Frequently filtered fields are
// real columns (not JSON) so activity, cost, and future policy/audit
// features can query and index them directly. `metadata` carries the
// long tail of action-specific detail.
// ---------------------------------------------------------------------------

enum ActivityType {
  TOOL_CALL
  MODEL_CALL
  DATA_ACCESS
  ACTION
  DEPLOYMENT
  COMMUNICATION
  FINANCIAL
  SYSTEM
}

enum ActivityStatus {
  ALLOWED
  BLOCKED
  APPROVAL_REQUIRED
  FAILED
  // Succeeded, but flagged as unusual/suspicious by risk scoring or a
  // detector — distinct from FAILED (the action itself didn't error) and
  // from BLOCKED (nothing stopped it). See lib/security/risk-scoring.ts.
  WARNING
}

// P1 — normalized vocabularies (lib/telemetry/normalize.ts). One
// representation per concept; callers' spellings are mapped onto these.

// The result of an action an agent reports it performed — distinct from
// ActivityStatus (which also encodes Aegis's *decision* for rows created by
// /evaluate). Null on decision rows: nothing has executed yet.
enum EventOutcome {
  SUCCESS
  FAILURE
  BLOCKED
  WARNING
}

// What kind of data an action touched. Caller-declared; an event may carry
// several. Sensitivity is derived from these server-side
// (lib/telemetry/normalize.ts#sensitivityForDataClasses), never lowered by
// the caller.
enum DataClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  PII
  FINANCIAL
  HEALTH
  CREDENTIALS
}

// How a destination was identified. Only the host / domain is ever stored —
// never a path, query string, userinfo, or an email's local part.
enum DestinationKind {
  HOST
  IP
  EMAIL_DOMAIN
}

model ActivityEvent {
  id             String @id @default(cuid())
  organizationId String
  agentId        String

  timestamp DateTime @default(now())

  eventType   ActivityType
  action      String // machine-readable action code, e.g. "read_crm_contact"
  resource    String? // e.g. "contact:acme-inc", "invoice:inv_1234" — this event's target
  description String?      @db.Text // optional human-readable summary supplied by the caller, e.g. "Read customer record for Acme Corp"
  toolName    String? // e.g. "CRM", "Zendesk" — which tool/integration performed this action, when known
  // How this row entered Aegis: "api" for a directly-reported event
  // (POST /api/v1/events) vs "policy_evaluation" for one created inline by
  // evaluateAgentAction(). Not an access-control concept — purely
  // provenance, so the UI/API can be honest about what was actually
  // observed vs decided (see AGENTS.md "WHAT THE AGENT DID, not only WHAT
  // THE AGENT SAID IT DID").
  source      String       @default("api")

  status    ActivityStatus @default(ALLOWED)
  riskLevel RiskLevel      @default(LOW)

  durationMs Int?

  modelProvider String?
  modelName     String?
  costCents     Int?

  // Optional cost-intelligence detail (Phase 5) — kept on ActivityEvent
  // rather than a separate table; see docs/cost-intelligence.md for why.
  inputTokens  Int?
  outputTokens Int?
  taskId       String?
  taskType     String?

  traceId       String?
  parentEventId String?

  errorMessage String? @db.Text
  metadata     Json?

  // --- P1 data foundation (docs/AEGIS_P1_DATA_FOUNDATION.md) -------------
  // Every field below is optional and only set when it can be populated
  // reliably; null always means "not reported / unknown", never a guess.
  // Rows are append-only after creation (DB trigger, see the P1 migration).

  // Caller-generated id for this event, unique per (organization, agent).
  // Makes re-delivery of the same logical event idempotent across process
  // restarts, and lets later events name it as their parent.
  clientEventId       String?
  // Parent reference by the caller's own id, kept as reported. Resolved to
  // parentEventId (same agent) immediately if the parent exists, or as soon
  // as the parent arrives (the one permitted NULL -> value change).
  parentClientEventId String?
  // The /evaluate decision this reported execution ran under (same agent).
  // Links "decided" to "done" — decision, matched policies, and approval
  // live on that PolicyEvaluation, not duplicated here.
  evaluationId        String?
  // When the caller says the action happened (validated window). `timestamp`
  // above remains Aegis's own receipt time — the trusted ordering.
  occurredAt          DateTime?
  // Snapshot of the agent's environment as configured in Aegis at ingest —
  // server-side, never caller-supplied. Null on pre-P1 rows (unknown).
  environment         Environment?
  // Normalized forms (lib/telemetry/normalize.ts). toolName above keeps the
  // caller's display spelling; toolKey is the identity ("CRM" == "crm").
  toolKey             String?
  service             String?
  destination         String?
  destinationKind     DestinationKind?
  // Keyed HMAC pseudonym of the end user the agent acted for — the raw id is
  // never stored (lib/telemetry/pseudonymize.ts).
  endUserHash         String?
  dataClasses         DataClass[]      @default([])
  dataSensitivity     RiskLevel?
  recordCount         Int?
  byteCount           Int?
  outcome             EventOutcome?
  // Deterministic, explainable signals observed at ingest/decision time
  // ([{ code, detail }]) — recorded evidence, not a risk score.
  riskSignals         Json?

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent                   Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyEvaluation        PolicyEvaluation?
  parent                  ActivityEvent?        @relation("ActivityEventParent", fields: [parentEventId], references: [id], onDelete: SetNull)
  children                ActivityEvent[]       @relation("ActivityEventParent")
  executedUnderEvaluation PolicyEvaluation?     @relation("ActivityEventExecutedUnder", fields: [evaluationId], references: [id], onDelete: SetNull)
  deviations              BehavioralDeviation[]

  @@unique([organizationId, agentId, clientEventId])
  @@index([organizationId, timestamp])
  @@index([agentId, timestamp])
  @@index([organizationId, status])
  @@index([organizationId, riskLevel])
  @@index([traceId])
  @@index([agentId, action]) // supports the "has this agent ever done this action before" existence check — lib/security/detectors.ts
  @@index([parentEventId])
  @@index([agentId, parentClientEventId])
  @@index([evaluationId])
  @@index([agentId, toolKey])
  @@index([agentId, destination])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Policy engine — Phase 2. Two layers feed every decision:
//
//   AgentPermission   the baseline capability of a specific agent
//                     ("what is this agent generally allowed to do?")
//
//   Policy            conditional rules layered on top of the baseline
//                     ("under these conditions, what should Aegis do?")
//
// Every evaluation resolves to exactly one of ALLOW / REQUIRE_APPROVAL /
// BLOCK using a fail-closed precedence: BLOCK beats REQUIRE_APPROVAL beats
// ALLOW, and an action with no matching permission or policy is BLOCKed by
// default. See docs/policy-engine.md for the full evaluation algorithm.
//
// PolicyEvaluation intentionally holds no foreign key to Policy or
// AgentPermission — only their IDs plus a point-in-time snapshot. A policy
// or permission can be edited or deleted later without corrupting the
// historical record of why a past action was allowed, blocked, or escalated.
// ---------------------------------------------------------------------------

enum PolicyDecision {
  ALLOW
  REQUIRE_APPROVAL
  BLOCK
  // The action is allowed to proceed — this is NOT an enforcement point —
  // but the match is recorded as a detected violation and raises a
  // SecurityAlert (lib/security/repository.ts#upsertAlertFinding). Never
  // conflate this with BLOCK: nothing here actually stops the action.
  ALERT
}

enum PolicyStatus {
  ACTIVE
  DISABLED
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  IN
  NOT_IN
  EXISTS
}

// Baseline capability of one agent for one action (+ optional resource).
// resource defaults to "" to mean "any resource" — kept non-null so the
// uniqueness constraint below actually enforces "no duplicate baseline
// rule for the same scope" (Postgres treats NULL as distinct from NULL).
model AgentPermission {
  id             String @id @default(cuid())
  organizationId String
  agentId        String

  action      String // e.g. "refund.issue", "crm.contact.read", "crm.*"
  resource    String         @default("") // "" = any resource
  decision    PolicyDecision
  description String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, action, resource])
  @@index([organizationId, agentId])
  @@map("agent_permissions")
}

// A conditional rule. Matches on structured scope fields first (fast,
// indexable) then, if all conditions also match, applies `decision`.
model Policy {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?               @db.Text
  status      PolicyStatus          @default(ACTIVE)
  priority    Int                   @default(100) // higher = considered more specific when explaining ties
  decision    PolicyDecision
  // How urgent a violation of this policy is. Drives the SecurityAlert's
  // severity when decision is ALERT; otherwise informational (shown in the
  // UI so BLOCK/REQUIRE_APPROVAL policies can still be triaged by impact).
  severity    SecurityAlertSeverity @default(MEDIUM)

  // Scope — all optional except action; unset fields mean "matches any".
  agentId     String? // null = applies to any agent in the org
  action      String // exact action, or a "prefix.*" wildcard
  resource    String?
  environment Environment?
  tool        String?
  riskLevel   RiskLevel?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  conditions   PolicyCondition[]

  @@index([organizationId, status])
  @@index([organizationId, agentId])
  @@map("policies")
}

// A single `field <operator> value` condition. All conditions on a policy
// are combined with AND. Field paths are resolved against a fixed
// whitelist (never evaluated as code) — see lib/policies/conditions.ts.
model PolicyCondition {
  id       String            @id @default(cuid())
  policyId String
  field    String // e.g. "context.amount", "environment", "riskLevel"
  operator ConditionOperator
  value    Json // string | number | boolean | array of those

  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_conditions")
}

// A persisted record of one evaluateAgentAction() call. This is the audit
// trail for the policy engine — see the note above the enums for why it
// deliberately avoids hard foreign keys into Policy/AgentPermission.
model PolicyEvaluation {
  id             String @id @default(cuid())
  organizationId String
  agentId        String

  action      String
  resource    String?
  environment Environment?
  tool        String?
  riskLevel   RiskLevel?
  context     Json?

  decision PolicyDecision
  reason   String         @db.Text

  permissionId       String?
  permissionSnapshot Json?

  matchedPolicyIds       String[]
  matchedPolicySnapshots Json?

  traceId         String?
  activityEventId String? @unique

  // P0 decision-correctness record (see docs/AEGIS_P0_IMPLEMENTATION.md).
  // All nullable: rows written before P0 simply don't have them.
  //   decisionSource  CONTROL (kill switch) | POLICY | DEFAULT_DENY |
  //                   APPROVAL (a consumed, human-approved request)
  //   agentStatus     the agent's control state at decision time
  //   matchingMode    STRICT | LEGACY (Organization.legacyPolicyMatching)
  //   claimed*        what the caller asserted, when the server-side value
  //                   was used instead — kept as evidence, never trusted
  //   consumedApprovalRequestId  the approval this evaluation used up
  decisionSource            String?
  agentStatus               AgentStatus?
  matchingMode              String?
  claimedEnvironment        Environment?
  claimedRiskLevel          RiskLevel?
  consumedApprovalRequestId String?

  // P4 unified risk engine — SHADOW ONLY (docs/AEGIS_P4_RISK_ENGINE.md).
  // Written once with the row (the table is append-only); none of it
  // influences `decision`. All nullable: rows written before P4, or when the
  // assessment was unavailable (timeout/failure), simply don't have it.
  //   riskAssessment             full structured explanation (lib/risk/types.ts)
  //   riskAssessedLevel          LOW | MEDIUM | HIGH | CRITICAL, for querying
  //   riskRecommendedDecision    what the risk engine would have decided
  //   riskShadowOutcome          AGREES | WOULD_ESCALATE | ACTUAL_STRICTER
  riskAssessment          Json?
  riskAssessedLevel       RiskLevel?
  riskRecommendedDecision PolicyDecision?
  riskShadowOutcome       String?

  // P5 control record — written with the row, like everything above.
  //   policyDecision     what permissions/policies alone resolved to
  //   riskControlMode    the EFFECTIVE mode applied (OBSERVE if globally disabled)
  //   riskControlOutcome OBSERVED | NO_CHANGE | ESCALATED | APPROVAL_HONORED |
  //                      UNAVAILABLE | KILL_SWITCH
  //   riskControl        the full snapshot (config, levels, trust state, signals)
  policyDecision     PolicyDecision?
  riskControlMode    RiskControlMode?
  riskControlOutcome String?
  riskControl        Json?

  createdAt DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activityEvent   ActivityEvent?   @relation(fields: [activityEventId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest?
  executions      ActivityEvent[]  @relation("ActivityEventExecutedUnder")
  riskReviewLabel RiskReviewLabel?

  @@index([organizationId, createdAt])
  @@index([agentId, createdAt])
  @@index([organizationId, decision])
  @@index([organizationId, riskShadowOutcome, createdAt])
  @@index([organizationId, riskControlOutcome, createdAt])
  @@index([traceId])
  @@map("policy_evaluations")
}

// ---------------------------------------------------------------------------
// Approvals — Phase 3. When evaluateAgentAction() resolves to
// REQUIRE_APPROVAL, an ApprovalRequest is created in the same transaction as
// the PolicyEvaluation it came from. The unique constraint on
// policyEvaluationId is the idempotency guarantee: a given evaluation can
// never produce more than one approval request, even under retries — see
// lib/approvals/repository.ts and docs/approvals-and-audit.md.
//
// ApprovalDecision rows are an append-only, immutable record of who
// approved or rejected a request. They are never edited or deleted by the
// application; a request that needs to change state again (e.g. an
// approval later cancelled) gets a new ApprovalRequest status transition
// and AuditEvent, not a rewritten decision.
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id             String @id @default(cuid())
  organizationId String
  agentId        String

  // One approval request per policy evaluation — see note above.
  policyEvaluationId String @unique

  action      String
  resource    String?
  environment Environment?
  tool        String?
  riskLevel   RiskLevel?
  context     Json?
  reason      String       @db.Text // snapshot of the policy engine's reason at request time

  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now())
  // Deadline for a human decision. Always set for requests created after
  // P0 (lib/approvals/config.ts). Null only on legacy rows the P0
  // migration couldn't backfill — treated as never-expiring PENDING.
  expiresAt   DateTime?
  resolvedAt  DateTime?

  // Execution binding (P0). An APPROVED request authorizes exactly one
  // execution of exactly the request that was approved:
  //   requestFingerprint  sha256 of the canonical approved request
  //                       (agent, action, resource, environment, tool,
  //                       context). Null = created before P0 -> can never be
  //                       consumed (request a new approval instead).
  //   executionExpiresAt  set at approval time; consumption after this fails
  //   consumedAt / consumedByEvaluationId  set atomically, once
  requestFingerprint     String?
  executionExpiresAt     DateTime?
  consumedAt             DateTime?
  consumedByEvaluationId String?   @unique

  traceId String?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent            Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyEvaluation PolicyEvaluation   @relation(fields: [policyEvaluationId], references: [id], onDelete: Cascade)
  decisions        ApprovalDecision[]

  @@index([organizationId, status, requestedAt])
  @@index([agentId, status])
  @@index([traceId])
  @@map("approval_requests")
}

// Immutable historical record of a human decision on an ApprovalRequest.
// decidedByUserId deliberately uses onDelete: Restrict (stronger than
// Policy.createdBy's SetNull) — Aegis must never lose who made an approval
// decision.
model ApprovalDecision {
  id                String               @id @default(cuid())
  organizationId    String
  approvalRequestId String
  decidedByUserId   String
  decision          ApprovalDecisionType
  comment           String?              @db.Text

  createdAt DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  decidedBy       User            @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([approvalRequestId])
  @@index([organizationId, createdAt])
  @@map("approval_decisions")
}

// ---------------------------------------------------------------------------
// Audit trail — Phase 3. Append-only from the application's perspective: no
// Server Action or UI ever updates or deletes an AuditEvent. actorUserId is
// nullable (and SetNull on delete, like Policy.createdBy) because
// SYSTEM-originated events (e.g. the policy engine requesting an approval)
// have no human actor.
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

enum AuditResult {
  SUCCESS
  FAILURE
}

model AuditEvent {
  id             String @id @default(cuid())
  organizationId String

  actorType   AuditActorType
  actorUserId String?
  agentId     String?

  eventType  String // e.g. "approval.requested", "policy.created" — see lib/audit/types.ts
  entityType String // e.g. "ApprovalRequest", "Policy", "AgentPermission", "Agent"
  entityId   String
  action     String
  result     AuditResult @default(SUCCESS)
  metadata   Json?
  traceId    String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, eventType])
  @@index([organizationId, entityType, entityId])
  @@index([traceId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// API keys & external ingestion — Phase 4. Lets a real agent process
// authenticate as an organization and call the public API
// (app/api/v1/*) to send activity, ask for a policy decision, and poll an
// approval's status, without a browser session.
//
// The raw key is never stored. Only `keyHash` (sha256 of the full raw
// key — see lib/api-keys/crypto.ts for why a fast hash is the right choice
// here, unlike the bcrypt used for user passwords) is persisted, and it is
// what authentication actually looks up by (`@unique`). `prefix` is a
// display-only truncation shown in the dashboard list — it carries no
// authentication weight.
// ---------------------------------------------------------------------------

enum ApiKeyEnvironment {
  LIVE
  TEST
}

model ApiKey {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  environment    ApiKeyEnvironment @default(LIVE)
  prefix         String
  keyHash        String            @unique
  scopes         String[]          @default(["events:write", "policy:evaluate", "approvals:read", "behavior:read", "trust:read", "graph:read"])

  // Agent binding (P0). Set = this key may only act as this one agent
  // (send its events, evaluate its actions, read its approvals) and may
  // not register new agents. Null = organization-wide key (explicit
  // choice at creation, shown as "All agents"). Cascade, never SetNull:
  // nulling the binding would silently widen the key to every agent.
  agentId String?

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  agent              Agent?              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  idempotencyRecords IdempotencyRecord[]
  agentConnections   AgentConnection[]

  @@index([organizationId, revokedAt])
  @@index([agentId])
  @@map("api_keys")
}

// Caches the response of a mutating API call by (apiKey, operation, caller
// idempotency key), so a retried POST /api/v1/evaluate (or /events) never
// double-creates an ApprovalRequest / ActivityEvent. `requestHash` detects
// a caller reusing the same Idempotency-Key with a different body, which
// is a conflict, not a valid retry — see lib/api/idempotency.ts.
model IdempotencyRecord {
  id             String @id @default(cuid())
  organizationId String
  apiKeyId       String

  operation    String // "events.create" | "evaluate.create" | "agents.register"
  key          String // caller-supplied Idempotency-Key header value
  requestHash  String // sha256 of the normalized request body
  statusCode   Int
  responseBody Json

  // Null = claimed but the handler hasn't finished yet (statusCode/
  // responseBody are placeholders). Claim-first is what stops two
  // concurrent retries with the same key from both running the handler —
  // see lib/api/idempotency.ts.
  completedAt DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Teams — Phase 5. Deliberately minimal: a name an agent can belong to, used
// for cost breakdowns and ownership display. No membership-to-team linking,
// no org chart. See docs/cost-intelligence.md.
// ---------------------------------------------------------------------------

model Team {
  id             String @id @default(cuid())
  organizationId String
  name           String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       Agent[]

  @@unique([organizationId, name])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// Member invitations — Phase 5. No email is sent (no mail provider exists
// in this codebase); an admin shares the generated link directly. See
// docs/rbac.md and lib/organizations/invitations.ts.
// ---------------------------------------------------------------------------

model OrganizationInvitation {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  role           MemberRole @default(ENGINEER)
  token          String     @unique

  invitedByUserId String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, acceptedAt])
  @@map("organization_invitations")
}

// ---------------------------------------------------------------------------
// Security alerts — Phase 5. `type` is a plain string (see
// lib/security/types.ts#SECURITY_ALERT_TYPES), not a Prisma enum, for the
// same reason AuditEvent.eventType is: a new detector should never need a
// migration. A cost anomaly is just another alert type (COST_SPIKE) —
// deliberately one alert system, not two — see docs/cost-intelligence.md.
//
// Deduplication: repeated triggers of the same (agentId, type) within a
// rolling window update `count`/`lastSeenAt` on the existing OPEN alert
// instead of creating a new row — see lib/security/repository.ts.
// ---------------------------------------------------------------------------

enum SecurityAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// How sure the detector is, distinct from severity (how bad it would be if
// true). A heuristic indicator (e.g. prompt-injection keyword match) must
// never be reported as certain — see lib/security/detectors.ts.
enum SecurityAlertConfidence {
  LOW
  MEDIUM
  HIGH
}

model SecurityAlert {
  id             String @id @default(cuid())
  organizationId String
  agentId        String

  type              String
  // Distinguishes findings of the same type that are genuinely different
  // things (a different action, tool, or policy) so dedup never merges
  // them. "" = one alert per (agent, type), the right grain for agent-wide
  // spikes. See lib/security/repository.ts#upsertAlertFinding.
  dedupeKey         String                   @default("")
  severity          SecurityAlertSeverity
  status            SecurityAlertStatus      @default(OPEN)
  title             String
  description       String                   @db.Text
  evidence          Json?
  traceId           String?
  // Null = the detector didn't rate its own confidence (most existing
  // baseline-relative detectors are deterministic, not probabilistic, so
  // this is only set by heuristic/indicator-style detectors).
  confidence        SecurityAlertConfidence?
  recommendedAction String?                  @db.Text

  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  resolvedAt           DateTime?
  resolvedByUserId     String?

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a security alert is evidence, and must never
  // silently disappear because its agent was deleted. There is no
  // agent-delete feature today, so this is currently dormant — but if one
  // ships, it will have to explicitly deal with an agent's alert history
  // rather than losing it for free. (Not SetNull: agentId here is
  // non-nullable by design, unlike AuditEvent.agentId — every alert is
  // always about a specific agent.)
  agent              Agent                     @relation(fields: [agentId], references: [id], onDelete: Restrict)
  acknowledgedByUser User?                     @relation("SecurityAlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedByUser     User?                     @relation("SecurityAlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  occurrences        SecurityAlertOccurrence[]

  @@index([organizationId, status, severity])
  @@index([agentId, type, dedupeKey])
  @@index([organizationId, firstSeenAt])
  @@map("security_alerts")
}

// One row per time a detector produced a finding for an alert — the first
// occurrence and every deduplicated repeat. The SecurityAlert row is the
// summary (count, first/last seen, highest severity); this table is the
// evidence, append-only, never overwritten. Cascade only with the alert
// itself, which is already Restrict-protected against agent deletion.
model SecurityAlertOccurrence {
  id             String @id @default(cuid())
  organizationId String
  alertId        String

  occurredAt  DateTime                 @default(now())
  severity    SecurityAlertSeverity
  confidence  SecurityAlertConfidence?
  title       String
  description String                   @db.Text
  evidence    Json?
  traceId     String?

  alert SecurityAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("security_alert_occurrences")
}

// Shared fixed-window rate-limit counters (P0) — see
// lib/rate-limit/limiter.ts#PostgresRateLimiter. One row per (key, window);
// rows past expiresAt are garbage and swept opportunistically.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Budgets — pure monitoring, not enforcement. Aegis has no mechanism to
// actually stop an agent from spending; exceeding a budget raises a
// SecurityAlert ("Budget exceeded — alert triggered"), never a claim that
// spending was blocked. See lib/costs/budgets.ts.
// ---------------------------------------------------------------------------

enum BudgetPeriod {
  DAILY
  MONTHLY
}

model Budget {
  id             String  @id @default(cuid())
  organizationId String
  // Null = organization-wide budget. Set = this one agent's own budget,
  // checked independently of (and in addition to) any org-wide budget.
  agentId        String?

  period                  BudgetPeriod
  limitCents              Int
  warningThresholdPercent Int          @default(80)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // No DB-level uniqueness on (organizationId, agentId, period): Postgres
  // treats NULLs as distinct, so it can't stop two org-wide (agentId=null)
  // budgets for the same period — that's enforced in lib/costs/budgets.ts
  // instead, at the application layer.
  @@index([organizationId, agentId])
  @@map("budgets")
}

// ---------------------------------------------------------------------------
// Outbound webhooks — Phase 5. Best-effort immediate delivery with a couple
// of bounded inline retries, not a durable queue (no background-job
// infrastructure exists in this environment) — see docs/webhooks.md for the
// explicit limitation. `secret` is shown once at creation, like ApiKey.
// ---------------------------------------------------------------------------

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id             String @id @default(cuid())
  organizationId String

  url              String
  secret           String
  status           WebhookEndpointStatus @default(ACTIVE)
  subscribedEvents String[]

  createdById String?
  createdAt   DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([organizationId, status])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

// Append-only delivery log — one row per attempt, not per event, so retries
// are visible individually.
model WebhookDelivery {
  id                String @id @default(cuid())
  webhookEndpointId String
  organizationId    String

  eventType  String
  payload    Json
  status     WebhookDeliveryStatus
  httpStatus Int?
  attempt    Int                   @default(1)

  createdAt DateTime @default(now())

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId, createdAt])
  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Billing. Paddle is the source of truth for subscription state; this table
// exists only so a replayed/duplicate webhook delivery can never be applied
// twice. Paddle notifications carry a stable
// `event_id` — that id is used directly as the primary key here, so a
// genuine retry (byte-identical event id) always hits the same row. See
// app/api/webhooks/paddle/route.ts.
// ---------------------------------------------------------------------------

model BillingWebhookEvent {
  id          String   @id // dedup key: Paddle's event_id
  type        String
  processedAt DateTime @default(now())

  @@map("billing_webhook_events")
}

// ---------------------------------------------------------------------------
// Leads — Phase 8. Not tenant-owned (no Organization exists yet at capture
// time) and deliberately not a full CRM: one table, no pipeline automation,
// no email sequencing engine. `status` is hand-updated by whoever reviews
// /admin/leads. See lib/leads/ and docs/gtm/weekly-loop.md.
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  TRIAL
  CUSTOMER
  DISQUALIFIED
}

enum LeadSource {
  CONTACT
  DEMO_REQUEST
  ENTERPRISE
}

model Lead {
  id      String @id @default(cuid())
  name    String
  email   String
  company String
  role    String

  // Qualification data — see docs/customer-research/interview.md for why
  // these specific questions. Free text, not enums: the ICP isn't settled
  // enough yet to force answers into a fixed taxonomy (see AGENTS.md
  // Phase 8 principle #85 — build from real customer data, not upfront).
  agentCount       String?
  aiStack          String?
  primaryChallenge String?
  message          String?

  status LeadStatus @default(NEW)
  source LeadSource @default(CONTACT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Feature requests — Phase 10. Org-scoped, not a cross-tenant public
// roadmap: members submit and vote on requests for their own organization.
// Status (REVIEWING/PLANNED/...) is triaged by platform staff via /admin —
// same shape as Lead's admin-side triage, not something an org's own
// members change about their own requests. `category` is free text, same
// "taxonomy not settled yet" reasoning as Lead's qualification fields.
//
// Vote count is deliberately NOT a denormalized integer on FeatureRequest —
// it's derived from FeatureRequestVote at query time (`_count`), which
// can't drift out of sync with the actual vote rows the way a manually
// incremented/decremented counter could.
// ---------------------------------------------------------------------------

enum FeatureRequestStatus {
  REQUESTED
  REVIEWING
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

model FeatureRequest {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  title       String
  description String?              @db.Text
  category    String?
  status      FeatureRequestStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes        FeatureRequestVote[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("feature_requests")
}

// One vote per (request, user) — the unique constraint is what makes a
// vote a toggle rather than something a member can stack.
model FeatureRequestVote {
  id               String @id @default(cuid())
  featureRequestId String
  userId           String

  createdAt DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
  @@map("feature_request_votes")
}

// ---------------------------------------------------------------------------
// P2 — Behavioral memory (docs/AEGIS_P2_BEHAVIORAL_MEMORY.md). Per-agent,
// explainable, deterministic statistics. No model, no global baseline.
// ---------------------------------------------------------------------------

// Hourly per-agent counters, one row per (agent, hour, dimension, key).
// Recomputed exactly from activity_events for CLOSED hours only: events are
// bucketed by Aegis's receipt `timestamp`, so a closed hour can never gain
// events and a recomputation is always correct (no incremental drift).
// Only "learnable" events count (status not BLOCKED / APPROVAL_REQUIRED),
// except the `decision` dimension, which records every policy decision.
model AgentActivityRollup {
  organizationId String
  agentId        String
  hourStart      DateTime
  dimension      String // total | action | eventType | tool | service | destination | dataClass | environment | endUser | outcome | decision | transition
  key            String // "" for `total`
  count          Int
  recordSum      Float    @default(0) // `total` only: sum of recordCount (double: exact to 2^53)
  byteSum        Float    @default(0) // `total` only: sum of byteCount

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, hourStart, dimension, key])
  @@index([agentId, dimension, hourStart])
  @@map("agent_activity_rollups")
}

// Processing state per agent (mutable bookkeeping — not evidence).
model AgentBehaviorState {
  agentId               String    @id
  organizationId        String
  // Exclusive end of the rolled-up history (an hour boundary). Hours before
  // this are complete in agent_activity_rollups.
  rollupThrough         DateTime?
  latestBaselineVersion Int       @default(0)
  lastRefreshedAt       DateTime?
  updatedAt             DateTime  @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("agent_behavior_states")
}

enum BaselineMaturity {
  NEW_AGENT
  LIMITED_HISTORY
  ESTABLISHED
}

// A versioned, immutable snapshot of "what is normal for this agent",
// computed from rollups over a trailing learning window that ends at the
// start of the current UTC day (today never teaches itself). A new version
// is appended at most once per UTC day; older versions are kept as history
// and are append-only (DB trigger).
model AgentBaseline {
  id                 String           @id @default(cuid())
  organizationId     String
  agentId            String
  version            Int
  methodologyVersion Int
  maturity           BaselineMaturity
  windowStart        DateTime
  windowEnd          DateTime
  eventsObserved     Int
  activeDays         Int
  activeHours        Int
  profile            Json // see lib/behavior/types.ts#BehaviorProfile
  computedAt         DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([organizationId, agentId, computedAt])
  @@map("agent_baselines")
}

enum BehavioralDeviationKind {
  NEW_TOOL
  NEW_DESTINATION
  NEW_SERVICE
  NEW_ACTION_TYPE
  NEW_END_USER
  UNUSUAL_DATA_TYPE
  UNUSUAL_SEQUENCE
  UNUSUAL_VOLUME
  UNUSUAL_FREQUENCY
  UNUSUAL_TIME
}

// "This agent is behaving differently from its established baseline" — one
// row per (agent, kind, subject, UTC day). The fields describing the first
// occurrence (what changed, why it's unusual, what was expected, the baseline
// version compared against, the triggering event) are immutable; only
// occurrences/lastSeenAt advance on repeats (DB trigger). Behavioral
// evidence only: deviations change no decision and raise no alert in P2.
model BehavioralDeviation {
  id              String                  @id @default(cuid())
  organizationId  String
  agentId         String
  kind            BehavioralDeviationKind
  dedupeKey       String
  day             DateTime // UTC day of first occurrence
  baselineVersion Int
  maturity        BaselineMaturity
  confidence      SecurityAlertConfidence
  eventId         String?
  observed        Json
  expected        Json
  explanation     String                  @db.Text
  firstSeenAt     DateTime                @default(now())
  lastSeenAt      DateTime                @default(now())
  occurrences     Int                     @default(1)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  event        ActivityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([agentId, kind, dedupeKey, day])
  @@index([organizationId, agentId, firstSeenAt])
  @@index([agentId, kind, day])
  @@map("behavioral_deviations")
}

// ---------------------------------------------------------------------------
// Agent trust (P3) — see docs/AEGIS_P3_AGENT_TRUST.md. A dynamic, explainable
// trust state derived ONLY from evidence Aegis already holds (behavioral
// deviations, policy outcomes, security alerts, approval rejections, operator
// control, agent age/baseline maturity). Informational in P3: trust blocks
// and changes no decision.
// ---------------------------------------------------------------------------

enum TrustState {
  TRUSTED
  NORMAL
  DEGRADED
  HIGH_RISK
  RESTRICTED
}

enum TrustTrigger {
  ACTIVITY_EVENT
  POLICY_EVALUATION
  APPROVAL_DECISION
  SECURITY_ALERT
  OPERATOR_CONTROL
  SCHEDULED
  ON_DEMAND
}

// The CURRENT trust state of an agent (mutable cache of the latest
// evaluation; the evidence of record is agent_trust_transitions).
model AgentTrustState {
  agentId            String     @id
  organizationId     String
  state              TrustState
  score              Int
  // When the agent entered the current state.
  stateSince         DateTime
  // Sequence number of the latest recorded transition.
  sequence           Int
  methodologyVersion Int
  // Current drivers (see lib/trust/types.ts): factors, limits, per-category totals.
  factors            Json
  limits             Json
  categories         Json
  evaluatedAt        DateTime
  updatedAt          DateTime   @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@map("agent_trust_states")
}

// One row per MEANINGFUL trust change (initialization, a state change, or a
// score move of at least TRUST_MIN_SCORE_DELTA). Append-only (DB trigger):
// each row snapshots the factors that explained it, so history stays
// readable after the source rows age out. `sequence` is gapless per agent;
// unique(agentId, sequence) is the integrity backstop for concurrent writers.
model AgentTrustTransition {
  id                 String       @id @default(cuid())
  organizationId     String
  agentId            String
  sequence           Int
  occurredAt         DateTime
  previousState      TrustState?
  newState           TrustState
  previousScore      Int?
  newScore           Int
  trigger            TrustTrigger
  // The event / evaluation / approval / alert that prompted the evaluation. No FK on purpose.
  triggerRef         String?
  summary            String       @db.Text
  factors            Json
  limits             Json
  changes            Json
  methodologyVersion Int

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentId, sequence])
  @@index([organizationId, agentId, occurredAt])
  @@map("agent_trust_transitions")
}

// An operator's judgement about one risk-flagged decision. The ONLY source of
// "was this a false positive?" — Aegis never infers it. One current label per
// evaluation (relabeling replaces it); every change is also an audit event.
model RiskReviewLabel {
  id             String               @id @default(cuid())
  organizationId String
  evaluationId   String               @unique
  label          RiskReviewLabelValue
  note           String?
  reviewedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evaluation   PolicyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([organizationId, label])
  @@map("risk_review_labels")
}

// ---------------------------------------------------------------------------
// P7 — Incident intelligence (docs/AEGIS_P7_INCIDENT_INTELLIGENCE.md).
//
// An Incident is a thin, durable HANDLE on a piece of stored evidence: which
// record triggered it (anchor), which run it belongs to (traceId), and the
// operator's handling of it (status, acknowledgement). Everything else — the
// timeline, the summary, the evidence list — is RECONSTRUCTED on read from the
// underlying append-only records (activity events, policy evaluations,
// approvals, alerts + occurrences, deviations, trust transitions), so an
// incident can never hold a fact the telemetry doesn't, and handling an
// incident never touches the security records it describes.
// ---------------------------------------------------------------------------

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

enum IncidentActivityKind {
  OPENED
  ACKNOWLEDGED
  STATUS_CHANGED
  NOTE
}

model Incident {
  id             String @id @default(cuid())
  organizationId String
  agentId        String
  // Human-friendly, per organization (INC-12). Assigned under a per-org lock.
  number         Int

  // One incident per (organization, agent, cluster): the run (trace) the trigger
  // belongs to, or the trigger record itself when it has no trace.
  // Immutable (DB trigger), like the anchor.
  clusterKey String
  anchorType String // SECURITY_ALERT | POLICY_EVALUATION | ACTIVITY_EVENT
  anchorId   String
  traceId    String?

  title    String
  // The highest severity of the evidence seen when last synced; only ever raised.
  severity RiskLevel

  status           IncidentStatus @default(OPEN)
  statusChangedAt  DateTime       @default(now())
  // Acknowledgement is separate from status and never touches the security record.
  acknowledgedAt   DateTime?
  acknowledgedById String?

  openedAt       DateTime @default(now())
  // ALERT_TRIGGER (opened automatically when a security alert was raised) | MANUAL
  openedVia      String
  openedByUserId String?
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activity     IncidentActivity[]

  @@unique([organizationId, agentId, clusterKey])
  @@unique([organizationId, number])
  @@index([organizationId, status, openedAt])
  @@index([organizationId, openedAt])
  @@index([agentId, openedAt])
  @@index([traceId])
  @@map("incidents")
}

// The incident's own audit trail. Append-only (DB trigger): opening, acknowledging,
// every status change and every note stays, with who and when, and a digest of the
// evidence set at that moment so "the evidence changed after this was closed" is
// detectable.
model IncidentActivity {
  id             String               @id @default(cuid())
  organizationId String
  incidentId     String
  kind           IncidentActivityKind
  fromStatus     IncidentStatus?
  toStatus       IncidentStatus?
  // Null = the system (e.g. a new alert reopened the incident).
  actorUserId    String?
  note           String?              @db.Text
  evidenceDigest String?
  evidenceCount  Int?
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
  @@map("incident_activity")
}

// ---------------------------------------------------------------------------
// Free AI Agent Risk Scanner (docs/AEGIS_FREE_RISK_SCANNER.md). Additive and
// isolated: scalar ids only, no foreign keys into legacy
// models. A scan is created anonymously (owned by a hashed browser-session
// token) and may later be claimed by a user/organization. Pasted text is NEVER
// stored: only the structured answers, allowlisted signal ids and the computed
// result are. `id` is a 128-bit random token generated in application code.
// ---------------------------------------------------------------------------

model RiskScan {
  id               String  @id
  sessionHash      String? // sha256 of the anonymous session token; the anonymous "owner"
  userId           String? // set when claimed
  organizationId   String? // set when claimed
  connectedAgentId String? // optional link to an Aegis agent

  agentType     String
  agentLabel    String? // sanitised free text for type "other"; never shown publicly
  capabilities  Json // string[] of allowlisted ids
  autonomy      Json // string[] of allowlisted ids
  controls      Json // { controlId: state }
  inputSignals  Json? // pasted-content signal ids + counts + char count; no text
  engineVersion String

  score         Int
  level         String // low | moderate | high | critical
  highRiskCount Int
  mediumCount   Int
  result        Json // the full structured ScanResult at the time of the scan

  isPublic    Boolean   @default(false)
  publicSlug  String?   @unique
  publishedAt DateTime?

  // Anonymous scans expire (30 days); claimed scans have no expiry. Published ones get 90 days.
  expiresAt DateTime?
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionHash])
  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@map("risk_scans")
}

// Append-only scanner funnel analytics. Never holds scan content: only event
// names, a hashed visitor id, ids and a few allowlisted scalar properties.
model ScannerAnalyticsEvent {
  id             String   @id @default(cuid())
  event          String
  visitorHash    String?
  scanId         String?
  organizationId String?
  properties     Json?
  createdAt      DateTime @default(now())

  @@index([event, createdAt])
  @@index([scanId])
  @@map("scanner_analytics_events")
}
